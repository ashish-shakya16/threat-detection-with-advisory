# Copy this file to .env and fill in real values. Never commit .env itself.

# Required: Flask session signing key. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Optional: comma-separated list of origins allowed to call the API cross-origin.
# Defaults to http://localhost:5000 if unset.
CORS_ALLOWED_ORIGINS=http://localhost:5000

# AI assistant language-model key (OpenAI-compatible or Hugging Face token).
# Only used when ai.enabled is true in config/config.yaml. Never put it in the
# frontend or in config files. Not needed for provider "ollama".
# SECUREX_AI_API_KEY=

# SMTP credentials for email alerts (notifications.enabled in config.yaml).
# Use an app password where the provider supports it (e.g. Gmail).
# SECUREX_SMTP_SENDER=alerts@example.com
# SECUREX_SMTP_PASSWORD=

# Dashboard URL used for links in alert and verification emails.
# SECUREX_DASHBOARD_URL=http://localhost:5000

# Optional: override the SQLite database path (useful for tests).
# THREAT_DB_PATH=data/db/threats.db

# Notification credentials (see config/config.yaml notifications.smtp section)
# SMTP_SENDER_PASSWORD=
# TWILIO_AUTH_TOKEN=
